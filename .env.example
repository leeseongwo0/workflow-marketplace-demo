# Shared
SUI_NETWORK=testnet
SUI_GRPC_URL=
SUI_EXPLORER_BASE_URL=

# Published objects
SUI_PACKAGE_ID=
MARKETPLACE_ID=
WORKFLOW_ROOT_ID=
WORKFLOW_RELEASE_ID=

# Walrus Testnet
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
WALRUS_STORAGE_EPOCHS=53
WALRUS_READ_TIMEOUT_MS=10000
WALRUS_MAX_BLOB_BYTES=1048576

# Local executor
EXECUTOR_HOST=127.0.0.1
EXECUTOR_PORT=3001
# Testnet-only signer used by deployment and bootstrap scripts.
SUI_DEPLOYER_PRIVATE_KEY=
# Exactly one of these two is required.
# EXECUTOR_PRIVATE_KEY: local/demo mode, unrelated to any attestation.
# ENCLAVE_IDENTITY_KEY_PATH: enclave mode — path to the key file written by
#   the sibling Rust process at boot (see write_enclave_identity_key in
#   enclave/src/nautilus-server/src/main.rs), so signatures are tied to a
#   specific attested measurement instead of an arbitrary key.
EXECUTOR_PRIVATE_KEY=
# ENCLAVE_IDENTITY_KEY_PATH=/tmp/enclave-identity.key
CORS_ORIGIN=http://127.0.0.1:5173
LOCAL_KEYRING_PATH=./data/local-keyring.json
# The chain has no field for encryptedBundleHash/publicManifestHash/keyId
# yet, so LocalDemoKeyProvider mode reads them from this local trusted
# file instead (written by bootstrap-release.ts, never derived from a
# downloaded bundle). Irrelevant once SealKeyProvider is wired in.
LOCAL_EXECUTION_BINDINGS_PATH=./data/local-execution-bindings.json
CHALLENGE_TTL_MS=300000
GOOGLE_NEWS_REQUEST_TIMEOUT_MS=8000
GOOGLE_NEWS_WINDOW_HOURS=24
GOOGLE_NEWS_MAX_RESULTS=10

# Web; only public values may use VITE_ prefix
VITE_EXECUTOR_BASE_URL=http://127.0.0.1:3001
VITE_SUI_NETWORK=testnet
VITE_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
VITE_SUI_PACKAGE_ID=
VITE_MARKETPLACE_ID=
VITE_WORKFLOW_RELEASE_ID=
VITE_SUI_EXPLORER_BASE_URL=
