# Shared
SUI_NETWORK=testnet
SUI_GRPC_URL=
SUI_EXPLORER_BASE_URL=

# Published objects
SUI_PACKAGE_ID=
MARKETPLACE_ID=
WORKFLOW_ROOT_ID=
WORKFLOW_RELEASE_ID=

# Walrus Testnet
WALRUS_PUBLISHER_URL=
WALRUS_AGGREGATOR_URL=
